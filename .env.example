# Documentation only; launch scripts do not automatically load this file.
# Set variables in your process/service environment. Never commit a real .env.
APP_PROFILE=dev
APP_STORAGE=h2-dev
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_ROLES=all
# Authenticated generic-source capture; application worker runs only in all/worker roles.
APP_GENERIC_INGEST_ENABLED=false
# Pure historical reparse worker; no device/alarm side effects.
APP_REPARSE_ENABLED=false
# Poll interval for authenticated generic-message application and real reparse workers.
APP_TASK_POLL_MS=500
# Hikvision FireCloud read-only device/fault/alarm/measurement synchronization.
# Keep secrets in a private service environment, never in this template.
# Discovered resources require explicit local unit assignment before business application.
HIKVISION_ENABLED=false
HIKVISION_APP_KEY=
HIKVISION_APP_SECRET=
HIKVISION_POLL_MS=30000
# Encrypts page-managed Hikvision credentials. Use an independent stable random 32-byte Base64 key.
# Empty or mismatched keys block credential writes; API responses never return the App Secret.
APP_HIKVISION_CONFIG_KEY=
# Native 980016 callback receiver is configured separately in the management UI, disabled initially.
# HTTPS shared-URL credential is encrypted with the Hikvision key; never put a real callback URL here.
# Decoder runs in all/ingest roles, independently of HIKVISION_ENABLED (the polling switch).
# Technical bounds: poll [100..60000]ms, batch [1..100] envelopes; no vendor latency/retry SLA.
APP_HIKVISION_CALLBACK_POLL_MS=1000
APP_HIKVISION_CALLBACK_BATCH_SIZE=10
# P8b1: V11+ APPLICATION traces always capture transactionally, even when both flags are off.
# This still adds storage cost/failure coupling; no retention/pruning/capacity promise.
APP_ALARM_CHANGE_READ_ENABLED=false
APP_ALARM_CHANGE_PUBLISH_ENABLED=false
APP_ALARM_CHANGE_POLL_MS=500
APP_ALARM_CHANGE_BATCH_SIZE=20
# P8b2 transport itself: explicit head-only signals, not entity updates or automatic HTTP catch-up/reconnect.
# Requires API/all role + read enabled; tickets are node-local (single API or sticky routing).
# Enabled requires an explicit exact canonical HTTP(S) Origin list; never wildcard/Host inference.
APP_ALARM_CHANGE_WS_ENABLED=false
APP_ALARM_CHANGE_WS_ALLOWED_ORIGINS=
# Example only: http://127.0.0.1:8080,http://localhost:5173
APP_ALARM_CHANGE_WS_POLL_MS=1000
APP_ALARM_CHANGE_WS_CONNECT_TIMEOUT_MS=10000
APP_ALARM_CHANGE_WS_SILENCE_TIMEOUT_MS=15000
APP_ALARM_CHANGE_WS_MAX_CONNECTIONS=32
APP_ALARM_CHANGE_WS_MAX_PER_SESSION=2
APP_ALARM_CHANGE_WS_SEND_TIMEOUT_MS=1000
APP_ALARM_CHANGE_WS_WORKER_THREADS=2
APP_ALARM_CHANGE_WS_MAX_MESSAGE_BYTES=4096
# Per-session <= total; silence > poll + send. These are validated technical resource policies, not SLAs.
# P8b3: allow reading an advisory finite retry policy, never default auto-connect.
# User must establish a genuine manual channel before explicit opt-in. Existing healthy channel survives window expiry.
# Success does not reset counts/window. This flag gates NEW policy reads, not instant revocation of an old pinned plan.
APP_ALARM_CHANGE_RECONNECT_ENABLED=false
APP_ALARM_CHANGE_RECONNECT_MAX_RETRIES=3
APP_ALARM_CHANGE_RECONNECT_DELAY_MS=1000
APP_ALARM_CHANGE_RECONNECT_WINDOW_MS=60000
# retries [1..10], delay [100..60000] ms, window [1000..600000] ms and window > delay.
# No automatic HTTP catch-up/entity refresh, no publisher-liveness/no-loss/SLA promise.
# Write-only contact phones: stable random 32-byte base64 key, shared by this DB's API/worker processes.
# Set securely in service environment; no built-in key/plaintext fallback or implicit rotation.
# Empty/mismatched key blocks contact writes/new queue, not existing safe reads or old modules.
APP_NOTIFICATION_CONTACT_KEY=
# Encrypts import plans and generated export files; independent from contact/Hikvision keys.
# Stable random 32-byte Base64, shared by API/worker processes using this database.
# Back up these keys with the database; do not regenerate them on each deployment.
APP_DATA_TRANSFER_KEY=
# Open-application data output (management /applications). Delivery is OFF by default and only runs in
# all/worker roles. Nothing is enabled by migration; no legacy iot_app/iot_app_forward row is imported.
APP_APPLICATION_OUTPUT_ENABLED=false
APP_APPLICATION_OUTPUT_POLL_MS=1000
APP_APPLICATION_OUTPUT_BATCH_SIZE=5
# Independent stable random 32-byte Base64 key: AES-GCM for the endpoint URL and its write-only credential.
# Empty/mismatched key rejects URL/credential writes and blocks every send; it never falls back to plaintext.
APP_APPLICATION_OUTPUT_KEY=
# Comma-separated exact public host allowlist. Empty means no endpoint can be stored or contacted.
# Hosts are re-resolved before each send; loopback/private/link-local/ULA/CGNAT/redirects are refused.
APP_APPLICATION_OUTPUT_ALLOWED_HOSTS=
APP_BOOTSTRAP_USERNAME=admin
APP_BOOTSTRAP_PASSWORD=
# Production: APP_PROFILE=prod, APP_STORAGE=postgresql, provision an empty dedicated database.
# APP_DB_URL=jdbc:postgresql://127.0.0.1:5432/fire_platform
# APP_DB_USERNAME=fire_app
# APP_DB_PASSWORD=
# APP_DB_POOL_MAX=5
# APP_DB_POOL_MIN=1
# Required if WeChat Pay is enabled: externally reachable HTTPS payment callback.
WECHAT_PAY_NOTIFY_URL=
# Real Aliyun alarm notifications (default off; explicitly enable only after provider credentials are configured).
FIRE_NOTIFICATION_REAL_ENABLED=false
FIRE_NOTIFICATION_ALIYUN_ACCESS_KEY_ID=
FIRE_NOTIFICATION_ALIYUN_ACCESS_KEY_SECRET=
FIRE_NOTIFICATION_ALIYUN_SMS_SIGN_NAME=
FIRE_NOTIFICATION_ALIYUN_SMS_TEMPLATE_CODE=
FIRE_NOTIFICATION_ALIYUN_TTS_CODE=
FIRE_NOTIFICATION_ALIYUN_TTS_CALLED_SHOW_NUMBER=
# Optional endpoint overrides for testing.
# FIRE_NOTIFICATION_ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
# FIRE_NOTIFICATION_ALIYUN_VOICE_ENDPOINT=https://dyvmsapi.aliyuncs.com/
# Platform operations evidence: absolute real directory (not a symlink) readable by the service user,
# containing the fixed operations-evidence.json (max 256 KiB, strict snake_case schema).
# The root release helper writes it only after real backup/restore/migration validation;
# encrypted/offline are descriptive facts, while restore isolation/hash checks stay required.
APP_OPS_EVIDENCE_DIR=
# Current release/build identity. APP_RELEASE_ID + actual artifact SHA-256 + built_at
# are required for the "PROVIDED" state; APP_RELEASE_SOURCE_COMMIT is optional and may stay
# empty for an uncommitted workspace (reported as not provided, never as an archive hash).
APP_RELEASE_ID=
APP_RELEASE_ARTIFACT_SHA256=
APP_RELEASE_SOURCE_COMMIT=
APP_RELEASE_BUILT_AT=
